{
  "name": "admitflow-full-frontend-ui-kit",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "offline": "node scripts/build-offline-preview.cjs",
    "screenshots": "python scripts/render-preview.py",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "verify:source": "node scripts/verify-source.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "@playwright/test": "1.64.1"
  }
}
