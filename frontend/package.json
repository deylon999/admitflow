{
  "name": "admitflow-full-frontend-ui-kit",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --host 0.0.0.0 --configLoader native",
    "offline": "node scripts/build-offline-preview.cjs",
    "screenshots": "python scripts/render-preview.py",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test.mjs",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "lint": "eslint src tests scripts/*.mjs *.ts *.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
