ENVIRONMENT=development
DATABASE_URL=sqlite:///./abiturient.db
SECURE_COOKIE=false
AUTO_CREATE_SCHEMA=true
RAW_STORE_PATH=./var/raw
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Required in production, e.g. https://admitflow.example
# PUBLIC_ORIGIN=
# Production: ENVIRONMENT=production, SECURE_COOKIE=true, AUTO_CREATE_SCHEMA=false.
# PostgreSQL connect_timeout defaults to 5 seconds; URL override must be 1..10.
# Account lifecycle is incomplete until KAN-214 PR3-6: leave disabled for users.
AUTH_ENABLED=false
# Required when enabled: stable random secret of at least32 UTF8 bytes; never commit.
# AUTH_RATE_KEY=
# Registration/verification/recovery mail remains503 until SMTP is configured.

# Real mail requires all fields, explicit HTTPS PUBLIC_ORIGIN and matching ALLOWED_HOSTS.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@your-domain.example
# SMTP_TIMEOUT_SECONDS=5
# ssl uses465 by default; plaintext/insecure TLS is unsupported. Do not commit credentials.
