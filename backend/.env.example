ENVIRONMENT=development
DATABASE_URL=sqlite:///./abiturient.db
SECURE_COOKIE=false
AUTO_CREATE_SCHEMA=true
RAW_STORE_PATH=./var/raw
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Required in production, e.g. https://admitflow.example
# PUBLIC_ORIGIN=
# Production: ENVIRONMENT=production, SECURE_COOKIE=true, AUTO_CREATE_SCHEMA=false.
# PostgreSQL connect_timeout defaults to 5 seconds; URL override must be 1..10.
# Account lifecycle is incomplete until KAN-214 PR3-6: leave disabled for users.
AUTH_ENABLED=false
# Required when enabled: stable random secret of at least32 UTF8 bytes; never commit.
# AUTH_RATE_KEY=
# Real registration delivery is unavailable until the PR4 SMTP adapter is configured.
