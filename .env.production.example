# Copy to .env next to compose.prod.yaml. Never commit the copy.
DOMAIN=admitflow.example
ACME_EMAIL=ops@admitflow.example
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32. Do not change later: it identifies candidates, see RUNBOOK.
SOURCE_IDENTITY_KEY=

# Optional compose.auth.yaml overlay. Keep real values only in private env/secrets.
# Stable independent random key (at least 32 bytes); never reuse DB/source keys.
AUTH_RATE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be verified with the provider; configure SPF/DKIM/DMARC at your DNS host.
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=5
# Controlled inbox for the explicit smoke command; not passed to the app.
AUTH_TEST_EMAIL=
